# Server Configuration
PORT=5000
CLIENT_URL=http://localhost:5173

# Database & JWT Security
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/studytrack?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d


# Google OAuth Integration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5000/api/calendar/callback

# Razorpay Payments Preparation (Phase 14 PRO Subscription)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Google Gemini AI Key (Backend Only)
GEMINI_API_KEY=your_gemini_api_key

